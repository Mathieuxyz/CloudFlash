<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CloudFlash.ViewModels"
             x:Class="CloudFlash.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Welcome to Kitbox" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        <TextBlock Text="Use the sidebar to navigate." Foreground="Gray" Margin="0,10,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
