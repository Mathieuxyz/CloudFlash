<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CloudFlash.ViewModels"
             x:Class="CloudFlash.Views.OrderStep3View"
             x:DataType="vm:OrderStep3ViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="25">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="STEP 3: ORDER TRACKING" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Track your order status in real time." Foreground="Gray" FontSize="14"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <!-- Search Box -->
                <Border Background="#2C3E50" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Search for an order" Foreground="White" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding SearchQuery}" Watermark="Enter order #, customer email, phone or ID"
                                     Background="#1A252F" Foreground="White" BorderThickness="0" Height="40" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Search" Command="{Binding LoadOrderCommand}"
                                    Background="#3498DB" Foreground="White" Margin="10,0,0,0" Padding="15,0" Height="40" FontWeight="Bold"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#F1C40F" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Multiple Orders List (Visible only if multiple found) -->
                <Border Background="#2C3E50" CornerRadius="8" Padding="20" IsVisible="{Binding HasMultipleOrders}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Multiple Matching Orders Found" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Select an order from the list to view its tracking and details:" Foreground="Gray" FontSize="13"/>
                        <ListBox ItemsSource="{Binding FoundOrders}" SelectedItem="{Binding SelectedOrder}" Background="#1A252F" MaxHeight="250" CornerRadius="5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="100,*,120,100" Margin="5" Background="Transparent">
                                        <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='Order #{0}'}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat='€{0:F2}'}" Foreground="#2E86C1" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#3498DB" FontWeight="Bold" HorizontalAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Order Details (Visible only if found) -->
                <Border Background="#2C3E50" CornerRadius="8" Padding="20" IsVisible="{Binding IsOrderFound}">
                    <StackPanel Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding CurrentOrder.Id, StringFormat='Order #{0}'}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding CurrentOrder.OrderDate, StringFormat='Date: {0:dd/MM/yyyy HH:mm}'}" Foreground="Gray"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1A252F" CornerRadius="15" Padding="15,5">
                                <TextBlock Text="{Binding CurrentOrder.Status}" Foreground="#3498DB" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Separator Background="#34495E" Height="1" Margin="0,10"/>

                        <Grid ColumnDefinitions="*, *, *">
                            <!-- Column 0: Financial Summary -->
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="FINANCIAL SUMMARY" Foreground="Gray" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentOrder.TotalAmount, StringFormat='Total: €{0:F2}'}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentOrder.DepositAmount, StringFormat='Deposit: €{0:F2}'}" Foreground="#E67E22"/>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="Deposit:" Foreground="Gray"/>
                                    <TextBlock Text="Paid" Foreground="#27AE60" IsVisible="{Binding CurrentOrder.DepositPaid}"/>
                                    <TextBlock Text="Pending" Foreground="#E74C3C" IsVisible="{Binding !CurrentOrder.DepositPaid}"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Column 1: Invoice Date -->
                            <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding CurrentOrder.InvoiceDate, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="INVOICE" Foreground="Gray" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentOrder.InvoiceDate, StringFormat='Issued on: {0:dd/MM/yyyy}'}" Foreground="White"/>
                            </StackPanel>

                            <!-- Column 2: Customer Attached -->
                            <StackPanel Grid.Column="2" Spacing="5" IsVisible="{Binding CurrentCustomer, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="CUSTOMER INFO" Foreground="Gray" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentCustomer.Email, StringFormat='Email: {0}', FallbackValue='-'}" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CurrentCustomer.Phone, StringFormat='Phone: {0}', FallbackValue='-'}" Foreground="#AED6F1"/>
                                <TextBlock Text="{Binding CurrentCustomer.Id, StringFormat='Customer ID: {0}'}" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#34495E" Height="1" Margin="0,5"/>

                        <Button Content="Mark as Invoiced"
                                Command="{Binding MarkAsInvoicedCommand}"
                                Background="#27AE60" Foreground="White"
                                Padding="15,10" FontWeight="Bold"
                                CornerRadius="6" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Navigation -->
        <Border Grid.Row="2" Background="#2C3E50" CornerRadius="8" Padding="15" Margin="0,20,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="Order Tracking" Foreground="Gray" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Back to Home" Command="{Binding GoHomeCommand}"
                        Background="Transparent" BorderBrush="#3498DB" BorderThickness="1" Foreground="#3498DB" Padding="15,10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
