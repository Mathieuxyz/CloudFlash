<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CloudFlash.ViewModels"
             x:Class="CloudFlash.Views.OrderStep2View"
             x:DataType="vm:OrderStep2ViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="25">
        <TextBlock Grid.Row="0" Text="CART &amp; STOCK CHECK" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <Border Background="#2C3E50" CornerRadius="5" Padding="15" MinHeight="100">
                    <Panel>
                        <ItemsControl ItemsSource="{Binding Cart}" IsVisible="{Binding IsCartVisible}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="30,80,*,100" Margin="0,5">
                                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding QuantityNeeded, StringFormat=' {0}x'}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PartInfo.Code}" Foreground="#AED6F1" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PartInfo.InStock, StringFormat='Stock: {0}'}" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <StackPanel IsVisible="{Binding IsOrderConfirmed}" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Order Confirmed!" FontSize="24" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding ConfirmedOrderNumber}" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Panel>
                </Border>
                <Border Background="#1A252F" CornerRadius="5" Padding="20" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Customer Details" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <TextBox Text="{Binding CustomerEmail}" Watermark="Email" Width="200" Background="#2C3E50" Foreground="White" Margin="0,0,20,10"/>
                            <TextBox Text="{Binding CustomerPhone}" Watermark="Phone" Width="200" Background="#2C3E50" Foreground="White" Margin="0,0,20,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#2C3E50" CornerRadius="5" Padding="20" Margin="0,20,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#F1C40F" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding TotalPrice, StringFormat='Total Price: €{0:F2}'}" FontSize="18" Foreground="White" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Deposit, StringFormat='Deposit Required: €{0:F2}'}" FontSize="14" Foreground="#E74C3C" IsVisible="{Binding HasMissingParts}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Confirm Order" Command="{Binding ConfirmOrderCommand}" Background="#27AE60" Foreground="White" Padding="20,15" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>