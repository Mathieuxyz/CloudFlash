<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CloudFlash.ViewModels"
             x:Class="CloudFlash.Views.CustomerView" 
             x:DataType="vm:CustomersViewModel"> <Grid RowDefinitions="Auto, *" Margin="25">
        <TextBlock Grid.Row="0" Text="CUSTOMERS MANAGEMENT" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
        
        <Grid Grid.Row="1" ColumnDefinitions="350, *">
            <Border Grid.Column = "0" Background="#2C3E50" CornerRadius="5" Padding="20" VerticalAlignment="Top" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="Add New Customer" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBox Text="{Binding Email}" Watermark="Email" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding Phone}" Watermark="Phone" Margin="0,0,0,15"/>
                    <Button Content="➕ Create / Select" Command="{Binding CreateAccountCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#2980B9"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#F1C40F" Margin="0,15,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#2C3E50" CornerRadius="5" Padding="15">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding AllCustomers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#34495E" BorderThickness="0,0,0,1" Padding="10">
                                    <Grid ColumnDefinitions="*, *">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Email}" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Id, StringFormat='(#{0})'}" Foreground="#F1C40F" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Phone}" Foreground="#AED6F1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>