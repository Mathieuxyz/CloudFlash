<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CloudFlash.ViewModels"
             x:Class="CloudFlash.Views.SupplierView"
             x:DataType="vm:SupplierViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="25">

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="SUPPLIER / STOCK MANAGEMENT"
                   FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

        <!-- Scrollable content: low stock + full stock -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="15">

                <!-- LOW STOCK -->
                <Border Background="#2C3E50" CornerRadius="5" Padding="15">
                    <StackPanel>
                        <TextBlock Text="LOW STOCK ITEMS — Action Required"
                                   Foreground="#E74C3C" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid ColumnDefinitions="160,*,80,80" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="Code"      Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Kind"      Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="In Stock"  Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="Min Stock" Foreground="Gray" FontSize="12"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding LowStockParts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="160,*,80,80" Margin="0,4">
                                        <TextBlock Grid.Column="0" Text="{Binding Code}"     Foreground="#AED6F1" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}"     Foreground="White"/>
                                        <TextBlock Grid.Column="2" Text="{Binding InStock}"  Foreground="#E74C3C"/>
                                        <TextBlock Grid.Column="3" Text="{Binding MinStock}" Foreground="Gray"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ALL STOCK -->
                <Border Background="#2C3E50" CornerRadius="5" Padding="15">
                    <StackPanel>
                        <TextBlock Text="ALL STOCK"
                                   Foreground="White" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid ColumnDefinitions="160,*,80,80,80" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="Code"      Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Kind"      Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="Color"     Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="In Stock"  Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="4" Text="Min Stock" Foreground="Gray" FontSize="12"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AllParts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="160,*,80,80,80" Margin="0,4">
                                        <TextBlock Grid.Column="0" Text="{Binding Code}"     Foreground="#AED6F1" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}"     Foreground="White"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Color}"    Foreground="Gray"/>
                                        <TextBlock Grid.Column="3" Text="{Binding InStock}"  Foreground="#27AE60"/>
                                        <TextBlock Grid.Column="4" Text="{Binding MinStock}" Foreground="Gray"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Action bar -->
        <Border Grid.Row="2" Background="#1A252F" CornerRadius="5" Padding="20" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto,10,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#F1C40F" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Generate Supplier Orders" Command="{Binding GenerateOrdersCommand}"
                        Background="#E67E22" Foreground="White" Padding="20,15" FontWeight="Bold"/>
                <Button Grid.Column="3" Content="Receive All Orders" Command="{Binding ReceiveAllOrdersCommand}"
                        Background="#27AE60" Foreground="White" Padding="20,15" FontWeight="Bold"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
