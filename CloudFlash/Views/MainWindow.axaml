<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CloudFlash.ViewModels"
        xmlns:sgs="using:SGS.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CloudFlash.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Kitbox - DB Test"
        Background="Black">

    <Grid ColumnDefinitions="200,*">

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Spacing="15" Margin="20,40,20,0">
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="#5D6D7E"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="CornerRadius" Value="3"/>
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#7F8C8D"/>
                    </Style>
                </StackPanel.Styles>

                <Button Content="Home"       Command="{Binding GoHomeCommand}"/>
                <Button Content="Load Parts" Command="{Binding LoadPartsCommand}"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" Margin="20">

            <!-- Status message -->
            <TextBlock Grid.Row="0"
                       Text="{Binding StatusMessage}"
                       Foreground="#AED6F1"
                       FontSize="14"
                       Margin="0,0,0,15"/>

            <!-- Search bar + button -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText}"
                         Watermark="Search by code, kind or color..."
                         Background="#2C3E50"
                         Foreground="White"
                         Padding="8"/>
                <Button Grid.Column="1"
                        Content="Search"
                        Command="{Binding SearchPartsCommand}"
                        Margin="10,0,0,0"
                        Background="#2980B9"
                        Foreground="White"
                        Padding="15,8"/>
            </Grid>

            <!-- Column headers -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="120,120,80,60,80,70"
                  Margin="0,0,0,5">
                <TextBlock Grid.Column="0" Text="Code"     Foreground="Gray" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="Kind"     Foreground="Gray" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="Color"    Foreground="Gray" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="Price"    Foreground="Gray" FontWeight="Bold"/>
                <TextBlock Grid.Column="4" Text="In Stock" Foreground="Gray" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="Min Stock" Foreground="Gray" FontWeight="Bold"/>
            </Grid>

            <!-- Parts list -->
            <ScrollViewer Grid.Row="3">
                <ItemsControl ItemsSource="{Binding Parts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="sgs:Part">
                            <Border Background="#1A252F"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,0,0,4">
                                <Grid ColumnDefinitions="120,120,80,60,80,70">
                                    <TextBlock Grid.Column="0" Text="{Binding Code}"
                                               Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                               Foreground="#AED6F1"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Color}"
                                               Foreground="#A9DFBF"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding CustomerPrice, StringFormat='€{0:F2}'}"
                                               Foreground="#F9E79F"/>
                                    <TextBlock Grid.Column="4" Text="{Binding InStock}"
                                               Foreground="White"/>
                                    <TextBlock Grid.Column="5" Text="{Binding MinStock}"
                                               Foreground="White"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
