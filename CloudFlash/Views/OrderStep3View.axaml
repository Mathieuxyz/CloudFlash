<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CloudFlash.ViewModels"
             x:Class="CloudFlash.Views.OrderStep3View"
             x:DataType="vm:OrderStep3ViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="25">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="STEP 3: ORDER TRACKING" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Suivez l'état de votre commande en temps réel." Foreground="Gray" FontSize="14"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <!-- Search Box -->
                <Border Background="#2C3E50" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Rechercher une commande" Foreground="White" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding SearchOrderId}" Watermark="Entrez le numéro de commande (ex: 123)" 
                                     Background="#1A252F" Foreground="White" BorderThickness="0" Height="40" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Rechercher" Command="{Binding LoadOrderCommand}" 
                                    Background="#3498DB" Foreground="White" Margin="10,0,0,0" Padding="15,0" Height="40" FontWeight="Bold"/>
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#F1C40F" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Order Details (Visible only if found) -->
                <Border Background="#2C3E50" CornerRadius="8" Padding="20" IsVisible="{Binding IsOrderFound}">
                    <StackPanel Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding CurrentOrder.Id, StringFormat='Commande N°{0}'}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding CurrentOrder.OrderDate, StringFormat='Date: {0:dd/MM/yyyy HH:mm}'}" Foreground="Gray"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1A252F" CornerRadius="15" Padding="15,5">
                                <TextBlock Text="{Binding CurrentOrder.Status}" Foreground="#3498DB" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Separator Background="#34495E" Height="1" Margin="0,10"/>

                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="RÉSUMÉ FINANCIER" Foreground="Gray" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentOrder.TotalAmount, StringFormat='Total: €{0:F2}'}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentOrder.DepositAmount, StringFormat='Acompte: €{0:F2}'}" Foreground="#E67E22"/>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="Statut Acompte:" Foreground="Gray"/>
                                    <TextBlock Text="Payé" Foreground="#27AE60" IsVisible="{Binding CurrentOrder.DepositPaid}"/>
                                    <TextBlock Text="En attente" Foreground="#E74C3C" IsVisible="{Binding !CurrentOrder.DepositPaid}"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding CurrentOrder.InvoiceDate, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="FACTURE" Foreground="Gray" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentOrder.InvoiceDate, StringFormat='Émise le: {0:dd/MM/yyyy}'}" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Navigation -->
        <Border Grid.Row="2" Background="#2C3E50" CornerRadius="8" Padding="15" Margin="0,20,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="CloudFlash Order Tracking System v1.0" Foreground="Gray" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Retour à l'accueil" Command="{Binding GoHomeCommand}" 
                        Background="Transparent" BorderBrush="#3498DB" BorderThickness="1" Foreground="#3498DB" Padding="15,10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
