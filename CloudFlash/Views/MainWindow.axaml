<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CloudFlash.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CloudFlash.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CloudFlash">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
        
        <TextBlock Text="{Binding Greeting}" 
                   FontSize="24" 
                   HorizontalAlignment="Center"/>

        <Border Padding="15" 
                Background="#2b2b2b" 
                CornerRadius="8" 
                MinWidth="300">
            <StackPanel Spacing="10">
                <TextBlock Text="Database Status:" 
                           Foreground="Gray" 
                           FontSize="12"/>
                <TextBlock Text="{Binding ConnectionStatus}" 
                           FontWeight="Bold" 
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ProgressBar IsIndeterminate="True" 
                     IsVisible="{Binding IsBusy}" 
                     Height="4" />

        <Button Content="Check DB Connection" 
                Command="{Binding CheckConnectionCommand}" 
                HorizontalAlignment="Center"
                Padding="20,10"
                Classes="accent" />
        
    </StackPanel>
</Window>