<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CloudFlash.ViewModels"
             x:Class="CloudFlash.Views.SupplierView" 
             x:DataType="vm:SupplierViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="25">
        <TextBlock Grid.Row="0" Text="SUPPLIER / STOCK MANAGEMENT" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1">
            <Border Background="#2C3E50" CornerRadius="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="LOW STOCK ITEMS (🔴 Action Required)" Foreground="#E74C3C" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid ColumnDefinitions="150,*,100,100" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" Text="Code" Foreground="Gray"/>
                        <TextBlock Grid.Column="1" Text="Kind" Foreground="Gray"/>
                        <TextBlock Grid.Column="2" Text="In Stock" Foreground="Gray"/>
                        <TextBlock Grid.Column="3" Text="Min Stock" Foreground="Gray"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding LowStockParts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="150,*,100,100" Margin="0,5">
                                    <TextBlock Grid.Column="0" Text="{Binding Code}" Foreground="#AED6F1" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="White"/>
                                    <TextBlock Grid.Column="2" Text="{Binding InStock}" Foreground="#E74C3C"/>
                                    <TextBlock Grid.Column="3" Text="{Binding MinStock}" Foreground="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#1A252F" CornerRadius="5" Padding="20" Margin="0,20,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#F1C40F" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="📤 Generate Supplier Orders" Command="{Binding GenerateOrdersCommand}" Background="#E67E22" Foreground="White" Padding="20,15" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>