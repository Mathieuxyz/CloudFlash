<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CloudFlash.ViewModels"
        xmlns:views="using:CloudFlash.Views"
        x:Class="CloudFlash.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Kitbox App - Modular"
        Background="#1E1E1E">

    <Window.DataTemplates> 
        <DataTemplate DataType="vm:HomeViewModel"><views:HomeView/></DataTemplate>
        <DataTemplate DataType="vm:OrderStep1ViewModel"><views:OrderStep1View/></DataTemplate>
        <DataTemplate DataType="vm:OrderStep2ViewModel"><views:OrderStep2View/></DataTemplate>
        <DataTemplate DataType="vm:OrderStep3ViewModel"><views:OrderStep3View/></DataTemplate>
        <DataTemplate DataType="vm:SupplierViewModel"><views:SupplierView/></DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="220,*">
        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#17202A">
            <StackPanel Spacing="5" Margin="15,30,15,0">
                <TextBlock Text="KITBOX" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#BDC3C7"/>
                        <Setter Property="Padding" Value="15,12"/>
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                    <Style Selector="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="TextAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#2C3E50"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </StackPanel.Styles>

                <Button Content="🏠 Home" Command="{Binding GoHomeCommand}"/>
                <TextBlock Text="NEW ORDER" Foreground="#7F8C8D" FontSize="11" FontWeight="Bold" Margin="15,20,0,5"/>
                <Button Content="  Step 1: Build Lockers" Command="{Binding GoToStep1Command}" />
                <Button Content="  Step 2: Cart &amp; Confirm" Command="{Binding GoToStep2Command}"/>
                <Button Content="  Step 3: Order Tracking" Command="{Binding GoToStep3Command}"/>
                <TextBlock Text="MANAGEMENT" Foreground="#7F8C8D" FontSize="11" FontWeight="Bold" Margin="15,20,0,5"/>
                <Button Content="🏭 Supplier" Command="{Binding GoToSupplierCommand}"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Column="1" Background="#1E1E1E">
            <TransitioningContentControl Content="{Binding CurrentPage}" />
        </Border>
    </Grid>
</Window>